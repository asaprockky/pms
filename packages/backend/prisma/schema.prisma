generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./pos.db"
}

model Organization {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  region          String     @default("UZ")
  dbName          String?
  // Data-residency & state-registry attestation (P12.1). PII databases are
  // hosted on local Uzbek infrastructure; these document the where + the
  // registry filing so residency is provable from the app.
  piiRegistryId   String? // state personal-data registry number
  dataResidency   String     @default("Tashkent, UZ (Tier III DC)")
  backupResidency String     @default("Uzbekistan (geo-replica)")
  registeredAt    DateTime? // when the PII DB was filed in the state registry
  createdAt       DateTime   @default(now())
  properties      Property[]
}

model Property {
  id                  String        @id @default(cuid())
  organizationId      String?
  name                String
  legalName           String?
  stars               Int           @default(3)
  address             String?
  city                String?
  country             String        @default("Uzbekistan")
  phone               String?
  email               String?
  website             String?
  taxId               String?
  currency            String        @default("UZS")
  checkInTime         String        @default("14:00")
  checkOutTime        String        @default("12:00")
  description         String?
  telegramBotToken    String?
  telegramGroupChatId String?
  telegramBotUsername String?
  paymeMerchantId     String?
  paymeKey            String?
  paymeTestMode       Boolean       @default(true)
  oneCEnabled         Boolean       @default(false)
  oneCUrl             String?
  oneCLogin           String?
  oneCPassword        String?
  oneCAutoExport      Boolean       @default(false)
  // Above-limit approval thresholds (P12.1) — JSON {action: limitUZS}; actions
  // exceeding these need GM/owner confirmation. Empty = platform defaults.
  approvalLimits      String        @default("{}")
  createdAt           DateTime      @default(now())
  organization        Organization? @relation(fields: [organizationId], references: [id])

  @@map("Hotel")
}

model Room {
  id                 String             @id @default(cuid())
  hotelId            String
  number             String
  type               String
  pricePerNight      Float
  status             String             @default("available")
  housekeepingStatus String             @default("clean")
  floor              String?
  capacity           Int                @default(2)
  createdAt          DateTime           @default(now())
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  workOrders         WorkOrder[]
  blocks             RoomBlock[]
  stays              Stay[]
  repairRequests     RepairRequest[]
}

model Stay {
  id            String      @id @default(cuid())
  hotelId       String
  reservationId String
  roomId        String
  checkIn       DateTime
  checkOut      DateTime
  status        String      @default("confirmed")
  isPrimary     Boolean     @default(false)
  ratePerNight  Float?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  room          Room        @relation(fields: [roomId], references: [id])

  @@index([roomId, checkIn, checkOut])
}

model RoomBlock {
  id        String   @id @default(cuid())
  hotelId   String
  roomId    String
  dateFrom  DateTime
  dateTo    DateTime
  reason    String   @default("maintenance")
  note      String?
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
}

model GroupBlock {
  id            String        @id @default(cuid())
  hotelId       String
  name          String
  color         String        @default("#3b82f6")
  note          String?
  companyId     String?
  ownerId       String?
  billing       String        @default("master")
  depositPct    Float         @default(30)
  arrivalDate   DateTime?
  departureDate DateTime?
  // Last date the block's unsold rooms stay held before release to inventory.
  cutoffDate    DateTime?
  roomingStatus String        @default("draft") // draft | submitted
  depositStatus String        @default("pending") // pending | paid | partial
  hallName      String?
  status        String        @default("open")
  createdAt     DateTime      @default(now())
  reservations  Reservation[]
  company       Company?      @relation(fields: [companyId], references: [id])
  folios        Folio[]
}

model Company {
  id               String           @id @default(cuid())
  hotelId          String
  name             String
  legalName        String?
  taxId            String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  contractFile     String?
  contractTerms    String?
  // Credit limit — how much this company may owe before new business stops.
  receivableLimit  Float            @default(0)
  segment          String? // corporate | agency | mice | government
  industry         String?
  managerId        String? // the salesperson who owns the relationship
  contractNo       String?
  contractDate     DateTime?
  contractTill     DateTime?
  // Days between invoice and payment being due (отсрочка платежа).
  deferralDays     Int              @default(0)
  // Allotment: rooms held for this company until the release date each night.
  allotmentRooms   Int              @default(0)
  allotmentCutoff  Int              @default(0) // days before arrival the hold drops
  // Agency terms: netto = they resell at their own price; commission = we pay %.
  agentRateType    String? // netto | commission
  agentCommission  Float            @default(0)
  contractCurrency String           @default("UZS")
  tags             String? // JSON array
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  groups           GroupBlock[]
  contacts         CompanyContact[]
  receivables      Receivable[]
  rates            CompanyRate[]
}

// Negotiated rate per room category. Quoting below these needs GM sign-off —
// the rule the mockup states as «Скидка глубже договорной применяется только
// после согласования GM».
model CompanyRate {
  id        String   @id @default(cuid())
  companyId String
  category  String // room type
  rate      Float
  meal      String? // BB | HB | FB | RO
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyContact {
  id        String   @id @default(cuid())
  companyId String
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Receivable {
  id            String    @id @default(cuid())
  hotelId       String
  companyId     String
  reservationId String?
  groupBlockId  String?
  invoiceNo     String?
  isEsf         Boolean   @default(false)
  dealTitle     String?
  managerName   String?
  description   String
  amount        Float
  paid          Float     @default(0)
  dueDate       DateTime
  status        String    @default("open")
  note          String?
  remindedAt    DateTime?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id])

  @@index([hotelId, status])
  @@index([companyId])
}

model User {
  id                  String   @id @default(cuid())
  hotelId             String?
  organizationId      String?
  name                String
  username            String   @unique
  password            String?
  passwordHash        String?
  role                String   @default("front_desk")
  active              Boolean  @default(true)
  twoFactorRequired   Boolean  @default(false)
  twoFactorEnabled    Boolean  @default(false)
  twoFactorSecret     String? // base32 TOTP secret (set on enrolment)
  telegramChatId      String?
  assignedPropertyIds String? // JSON array of property ids a manager may access (null = home hotel only)
  accessRoleId        String? // custom Lego role (overrides the legacy `role` defaults when set)
  // Newest release-notes version this person has already been shown. Lives on
  // the user, not in localStorage, so the popup stays seen across their phone,
  // the front-desk PC and a cleared browser instead of replaying on each.
  seenReleaseVersion  String?
  createdAt           DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  hotelId        String?
  actorId        String?
  actorName      String?
  actorRole      String?
  action         String
  entity         String?
  entityId       String?
  meta           String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([entity, entityId])
}

model HousekeepingTask {
  id           String    @id @default(cuid())
  hotelId      String
  roomId       String
  status       String    @default("dirty")
  assignedToId String?
  note         String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  room         Room      @relation(fields: [roomId], references: [id])
}

model WorkOrder {
  id             String           @id @default(cuid())
  hotelId        String
  roomId         String?
  title          String
  description    String?
  priority       String           @default("medium")
  status         String           @default("open")
  assignedToId   String?
  reportedById   String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  // What is broken. A hotel's work is not all rooms — a lift, a boiler or a
  // lobby has no room number, so the object is a kind plus a free label.
  objectKind     String           @default("room") // room | villa | public | equipment
  objectRef      String? // label for anything that is not a room
  photoUrls      String? // JSON array — the phone photo the reporter attached
  // Filled when the job is closed. Without it "Выполнено" is just a colour.
  resolutionNote String?
  // The lock: this ticket is why the room cannot be sold.
  blocksSale     Boolean          @default(false)
  // Deadline, computed from priority when the ticket is raised. Server-side so
  // every client agrees on what is overdue instead of each recomputing it.
  slaDueAt       DateTime?
  startedAt      DateTime?
  room           Room?            @relation(fields: [roomId], references: [id])
  events         WorkOrderEvent[]
}

// Ticket history. Every assignment, status move and block is appended here, so
// "who sat on this for two days" is answerable.
model WorkOrderEvent {
  id          String    @id @default(cuid())
  workOrderId String
  kind        String // created | assigned | status | blocked | unblocked | note
  text        String
  byId        String?
  createdAt   DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(cuid())
  hotelId      String
  category     String    @default("task")
  title        String
  note         String?
  priority     String    @default("medium")
  status       String    @default("open")
  assignedToId String?
  createdById  String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  doneAt       DateTime?
}

model NightAudit {
  id           String   @id @default(cuid())
  hotelId      String
  businessDate String
  snapshot     String
  runById      String?
  createdAt    DateTime @default(now())
}

model Guest {
  id            String          @id @default(cuid())
  hotelId       String
  fullName      String
  phone         String
  email         String?
  dob           DateTime?
  docType       String          @default("passport")
  pinfl         String?
  passportNo    String?
  citizenship   String?
  pdnConsent    Boolean         @default(false)
  consentAt     DateTime? // when explicit PII consent was captured (GDPR, P12.1)
  consentSource String? // where consent was given: check_in | e_mehmon | portal
  anonymizedAt  DateTime? // set on right-to-erasure; identifiers scrubbed
  preferences   String          @default("[]")
  tags          String          @default("[]")
  createdAt     DateTime        @default(now())
  reservations  Reservation[]
  notes         GuestNote[]
  messages      Message[]
  feedback      Feedback[]
  incidents     GuestIncident[]
  upsellScores  UpsellScore[]
}

/// AI upsell propensity scores per guest/reservation/offer (P7.4).
model UpsellScore {
  id               String    @id @default(cuid())
  hotelId          String
  guestId          String
  reservationId    String
  offerType        String
  probability      Float     @default(0)
  thresholdMet     Boolean   @default(false)
  scoreInputs      String    @default("{}")
  sentAt           DateTime?
  sentVia          String?
  revenueGenerated Float     @default(0)
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  guest            Guest     @relation(fields: [guestId], references: [id])

  @@index([hotelId, probability])
  @@index([reservationId])
}

model GuestIncident {
  id         String    @id @default(cuid())
  hotelId    String
  guestId    String
  title      String
  detail     String?
  severity   String    @default("medium")
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  guest      Guest     @relation(fields: [guestId], references: [id])
}

model Message {
  id            String    @id @default(cuid())
  hotelId       String
  guestId       String
  reservationId String?
  campaignId    String?
  channel       String    @default("email")
  template      String
  body          String
  status        String    @default("scheduled")
  scheduledFor  DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  guest         Guest     @relation(fields: [guestId], references: [id])
}

model Feedback {
  id            String      @id @default(cuid())
  hotelId       String
  guestId       String
  reservationId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  guest         Guest       @relation(fields: [guestId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model Campaign {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  segment   String
  template  String
  channel   String   @default("email")
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
}

model GuestNote {
  id        String   @id @default(cuid())
  hotelId   String
  guestId   String
  text      String
  createdAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id])
}

model Reservation {
  id                 String      @id @default(cuid())
  hotelId            String
  guestId            String
  roomId             String
  checkIn            DateTime
  checkOut           DateTime
  totalPrice         Float
  status             String      @default("pending")
  source             String      @default("manual")
  emehmonStatus      String      @default("pending")
  emehmonSubmittedAt DateTime?
  emehmonDeadline    DateTime?
  onlineCheckedIn    Boolean     @default(false)
  keyCode            String?
  note               String? // free-text booking comment (front desk)
  guestCount         Int         @default(1) // how many people will actually stay (≤ room capacity)
  extraGuestIds      String? // JSON array of co-guest ids (optional; primary is guestId)
  guestEmehmon       String? // JSON map: guestId -> { status, submittedAt } — per-guest E-Mehmon within the group
  /// Deposit + cutoff (Reservations module). The cutoff is the point by which
  /// the deposit must arrive or the room returns to inventory; what happens
  /// then is a property setting, not a hardcoded rule — see ReservationSettings.
  depositAmount      Float       @default(0)
  depositDueAt       DateTime?
  depositPaidAt      DateTime?
  /// Set when the room was actually released back to inventory at cutoff.
  releasedAt         DateTime?
  cancelReason       String?
  /// No-show is a distinct outcome from cancellation — the guest never
  /// arrived and never cancelled, and the money is handled differently.
  noShowAt           DateTime?
  depositForfeited   Boolean     @default(false)
  createdAt          DateTime    @default(now())
  guest              Guest       @relation(fields: [guestId], references: [id])
  room               Room        @relation(fields: [roomId], references: [id])
  groupBlockId       String?
  payments           Payment[]
  charges            Charge[]
  feedback           Feedback?
  folios             Folio[]
  stays              Stay[]
  groupBlock         GroupBlock? @relation(fields: [groupBlockId], references: [id])
}

model Folio {
  id            String       @id @default(cuid())
  hotelId       String
  reservationId String?
  groupBlockId  String?
  type          String       @default("guest")
  status        String       @default("open")
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  groupBlock    GroupBlock?  @relation(fields: [groupBlockId], references: [id])
  charges       Charge[]
  payments      Payment[]
}

model Charge {
  id            String       @id @default(cuid())
  hotelId       String
  reservationId String?
  folioId       String?
  description   String
  category      String
  outlet        String       @default("front_desk")
  amount        Float
  // The unit `amount` is in. Canonical is UZS, whole som — see docs/MONEY.md.
  // Explicit rather than assumed: this column is what makes a folio total
  // auditable, and what lets computeFolioTotals refuse to add two scales
  // together instead of silently producing a meaningless number.
  currency      String       @default("UZS")
  taxRate       Float        @default(0)
  staffId       String?
  serviceTime   DateTime?
  createdAt     DateTime     @default(now())
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  folio         Folio?       @relation(fields: [folioId], references: [id])
}

model Payment {
  id            String       @id @default(cuid())
  hotelId       String
  reservationId String?
  folioId       String?
  amount        Float
  /// Unit of `amount`. Canonical UZS, whole som — see docs/MONEY.md.
  currency      String       @default("UZS")
  method        String
  // Name of the staff member who processed the payment (audit / anti-fraud).
  cashier       String?
  // Payments are written 'completed' immediately (synchronous cashier flow);
  // only 'completed' payments count toward a folio balance. 'pending' is
  // reserved for future async gateways. A negative amount is a refund.
  status        String       @default("completed")
  createdAt     DateTime     @default(now())
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  folio         Folio?       @relation(fields: [folioId], references: [id])
  receipt       Receipt?
}

model Receipt {
  id         String   @id @default(cuid())
  hotelId    String
  paymentId  String   @unique
  fiscalSign String
  qrPayload  String
  offline    Boolean  @default(false)
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id])
}

model PaymeTransaction {
  id            String   @id @default(cuid())
  hotelId       String
  paymeId       String   @unique
  reservationId String?
  account       String
  amount        Float
  state         Int      @default(1)
  reason        Int?
  createTime    Float    @default(0)
  performTime   Float    @default(0)
  cancelTime    Float    @default(0)
  paymentId     String?
  createdAt     DateTime @default(now())

  @@index([hotelId])
  @@index([reservationId])
}

model Document {
  id            String   @id @default(cuid())
  hotelId       String
  type          String
  status        String   @default("issued")
  number        String?
  folioId       String?
  paymentId     String?
  reservationId String?
  guestId       String?
  groupBlockId  String?
  dealId        String?
  url           String?
  payload       String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([hotelId, type])
  @@index([folioId])
  @@index([paymentId])
  @@index([reservationId])
}

model RatePlan {
  id                String    @id @default(cuid())
  hotelId           String
  name              String
  roomType          String
  baseRate          Float
  weekendMultiplier Float     @default(1)
  kind              String    @default("bar")
  parentId          String?
  adjustmentPct     Float     @default(0)
  visibility        String    @default("public")
  companyId         String?
  minLos            Int       @default(1)
  active            Boolean   @default(true)
  // Mockup's "Тарифы и ограничения" table columns not yet stored anywhere.
  maxLos            Int?
  meal              String? // BB | HB | FB | RO
  cancelPolicy      String? // free text, e.g. "Бесплатно за 3 дня"
  channels          String? // JSON array of channel keys this plan is sold on
  validFrom         DateTime?
  validTo           DateTime?
  createdAt         DateTime  @default(now())
}

model PromoCode {
  id          String    @id @default(cuid())
  hotelId     String
  code        String
  discountPct Float
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean   @default(true)
  usageLimit  Int?
  usedCount   Int       @default(0)
  channels    String? // JSON array — promos are direct-only by default (empty = direct)
  createdAt   DateTime  @default(now())

  @@unique([hotelId, code])
}

model Package {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  roomType  String?
  services  String   @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RateRestriction {
  id        String   @id @default(cuid())
  hotelId   String
  roomType  String?
  dateFrom  DateTime
  dateTo    DateTime
  type      String   @default("stop_sell")
  value     Int      @default(0)
  createdAt DateTime @default(now())
}

model PricingRule {
  id         String   @id @default(cuid())
  hotelId    String
  name       String
  dateFrom   DateTime
  dateTo     DateTime
  multiplier Float
  // A season is a PricingRule with a switch and a scope, so the two didn't
  // need separate models — «Название · Период · Множитель · Применяется к ·
  // Источник · Вкл» from the mockup maps onto these four extra columns.
  active     Boolean  @default(true)
  roomType   String? // null = applies to every room type
  source     String   @default("manual") // manual | uz_calendar
  createdAt  DateTime @default(now())
}

model ChannelConnection {
  id         String    @id @default(cuid())
  hotelId    String
  channel    String
  apiKey     String?
  apiSecret  String?
  hotelCode  String?
  status     String    @default("active")
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())

  @@unique([hotelId, channel])
}

model ChannelMapping {
  id              String   @id @default(cuid())
  hotelId         String
  channel         String
  roomType        String
  channelRoomId   String?
  ratePlanId      String?
  channelRateCode String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([hotelId, channel, roomType])
}

model ChannelSyncLog {
  id        String   @id @default(cuid())
  hotelId   String
  channel   String
  direction String
  action    String
  status    String
  message   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([hotelId, channel, createdAt])
}

// ─── Competitor rate shopping ──────────────────────────────────────────────
model Competitor {
  id        String           @id @default(cuid())
  hotelId   String
  name      String
  source    String           @default("manual") // manual | scraped
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  rates     CompetitorRate[]
}

model CompetitorRate {
  id           String     @id @default(cuid())
  competitorId String
  date         DateTime
  rate         Float
  createdAt    DateTime   @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([competitorId, date])
}

// ─── Demand calendar — manual events layered on the built-in UZ calendar ───
model DemandEvent {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  kind      String   @default("local") // local | citywide | national | hotel
  priority  String   @default("normal") // low | normal | high
  dateFrom  DateTime
  dateTo    DateTime
  effectPct Float    @default(0) // suggested rate uplift, e.g. 15 = +15%
  note      String?
  createdAt DateTime @default(now())

  @@index([hotelId, dateFrom])
}

// ─── Budget: monthly targets with restorable versions ──────────────────────
model Budget {
  id           String   @id @default(cuid())
  hotelId      String
  year         Int
  month        Int // 1-12
  revenue      Float    @default(0)
  occupancyPct Float    @default(0)
  adr          Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([hotelId, year, month])
  @@index([hotelId, year])
}

// A full-year snapshot, taken every time the budget is saved, so any earlier
// version can be restored without losing what is current — «Восстановить
// можно любую предыдущую версию — текущая при этом сохранится как новая».
model BudgetVersion {
  id          String   @id @default(cuid())
  hotelId     String
  year        Int
  label       String
  rows        String // JSON: { month, revenue, occupancyPct, adr }[]
  createdAt   DateTime @default(now())
  createdById String?

  @@index([hotelId, year, createdAt])
}

// ─── Reports: schedule + export history ─────────────────────────────────────
model ReportSchedule {
  id         String    @id @default(cuid())
  hotelId    String
  reportKey  String // e.g. channel_pnl, occupancy_trend
  frequency  String    @default("weekly") // daily | weekly | monthly
  channel    String    @default("email") // email | telegram
  recipients String // JSON array of addresses/chat ids
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
}

model ReportExport {
  id          String   @id @default(cuid())
  hotelId     String
  reportKey   String
  periodFrom  DateTime
  periodTo    DateTime
  format      String   @default("csv") // csv | xlsx
  sizeBytes   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
}

model InboxThread {
  id              String         @id @default(cuid())
  hotelId         String
  channel         String
  contactId       String?
  contactName     String?
  guestId         String?
  ownerId         String?
  lastMessageAt   DateTime       @default(now())
  status          String         @default("open")
  slaBreachedAt   DateTime?
  /// Which department currently owns this conversation. One inbox, many
  /// queues: a department only works its own threads, and a thread moves
  /// between queues by transfer rather than by everyone reading everything.
  /// front_desk | reservations | housekeeping | maintenance | fnb | spa |
  /// finance | sales | marketing
  department      String         @default("front_desk")
  /// Set when a thread is moved, so the receiving department can see it
  /// arrived from somewhere rather than appearing out of nowhere.
  transferredAt   DateTime?
  transferredFrom String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        InboxMessage[]

  @@index([hotelId, status])
  @@index([hotelId, department])
  @@index([contactId])
}

model InboxMessage {
  id          String      @id @default(cuid())
  threadId    String
  direction   String
  channel     String
  text        String
  contentType String      @default("text")
  payload     String?
  sentById    String?
  createdAt   DateTime    @default(now())
  thread      InboxThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

/// A guest who wanted dates the property could not sell, kept instead of
/// turned away. Never auto-converts to a booking: when a room frees up staff
/// are notified and confirm with the guest first, because the freed room may
/// not match every detail (party size, exact dates).
model Waitlist {
  id            String    @id @default(cuid())
  hotelId       String
  guestId       String?
  guestName     String
  phone         String
  email         String?
  fromDate      DateTime
  toDate        DateTime
  roomType      String
  partySize     Int       @default(2)
  /// phone | inbox | walk_in | ota
  capturedVia   String    @default("phone")
  /// waiting | offered | converted | expired | cancelled
  status        String    @default("waiting")
  note          String?
  /// Stamped when staff were told a matching room opened up.
  notifiedAt    DateTime?
  /// Reservation created after the guest confirmed — the link is what proves
  /// the waitlist actually converted rather than being quietly dropped.
  reservationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hotelId, status])
  @@index([hotelId, roomType, fromDate])
}

/// Immutable record of one change to a booking. Amendments never overwrite the
/// original terms — revenue reporting needs to know what was booked versus
/// what it became, and a guest dispute needs to know what was promised.
model ReservationAmendment {
  id            String   @id @default(cuid())
  hotelId       String
  reservationId String
  /// dates | room_type | rate | party_size | cancel | no_show | release
  kind          String
  /// JSON snapshot of the fields that changed, before and after.
  before        String
  after         String
  reason        String?
  actorId       String?
  actorName     String?
  createdAt     DateTime @default(now())

  @@index([reservationId, createdAt])
  @@index([hotelId, createdAt])
}

/// Property-level Reservations policy. Deliberately data, not constants: some
/// properties want the room released automatically at cutoff, others want a
/// human to make that call every time.
model ReservationSettings {
  id                 String   @id @default(cuid())
  hotelId            String   @unique
  /// remind | release | manual — what happens when a deposit cutoff passes.
  cutoffAction       String   @default("remind")
  /// Default hours before arrival that the deposit is due.
  depositLeadHours   Int      @default(72)
  /// Default deposit as a percent of the booking total.
  depositPercent     Float    @default(30)
  /// How long a waitlist entry stays live before it expires.
  waitlistExpiryDays Int      @default(30)
  /// Deposit is forfeited on a no-show when the policy says so.
  forfeitOnNoShow    Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model MarketingScenario {
  id         String   @id @default(cuid())
  hotelId    String
  name       String
  trigger    String
  delayHours Int      @default(0)
  templateRu String
  templateUz String
  templateEn String
  channel    String   @default("telegram")
  segment    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketingEffect {
  id               String    @id @default(cuid())
  hotelId          String
  scenarioId       String
  sentCount        Int       @default(0)
  openedCount      Int       @default(0)
  reactedCount     Int       @default(0)
  revenueGenerated Float     @default(0)
  periodFrom       DateTime?
  periodTo         DateTime?
  createdAt        DateTime  @default(now())
}

model Lead {
  id                String    @id @default(cuid())
  hotelId           String
  fullName          String
  phone             String
  email             String?
  source            String
  stage             String    @default("new")
  ownerId           String?
  guestId           String?
  note              String?
  checkIn           String?
  checkOut          String?
  roomType          String?
  budget            Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  respondedAt       DateTime?
  /// Funnel timestamps — first qualification and the proposal round-trip.
  qualifiedAt       DateTime?
  proposalSentAt    DateTime?
  /// Proposals expire (configurable per property) — the deadline is the urgency lever.
  proposalExpiresAt DateTime?
  proposalAmount    Float?
  /// 0–100 heuristic: budget fit, dates given, returning guest, source quality.
  fitScore          Int?
  suggestedUpsell   String?
  /// Follow-up ladder position: 0 none → 1 nudge → 2 urgency → 3 win-back sent.
  followUpStage     Int       @default(0)
  lostReason        String?
  /// Set when a B2B/group inquiry is handed off to the Sales pipeline.
  handoffDealId     String?

  @@index([hotelId, stage])
  @@index([hotelId, source])
}

/// Timeline of everything that happened to a lead — stage moves, automated
/// follow-ups, proposals, notes. This is what guarantees the spec's "no lead
/// is ever silently dropped": every touch is on the record.
model LeadActivity {
  id        String   @id @default(cuid())
  hotelId   String
  leadId    String
  /// note | stage | qualified | proposal | nudge | urgency | win_back | handoff | lost | auto_lost
  kind      String
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([hotelId, createdAt])
}

/// Per-property knobs for the lead follow-up sequence and proposal expiry.
/// The spec makes these a business decision, not fixed rules — so they live
/// in data, one row per hotel, editable from the Leads screen.
model MarketingSettings {
  id                  String   @id @default(cuid())
  hotelId             String   @unique
  /// Gentle follow-up when a new lead has had no reply for this many hours.
  nudgeAfterHours     Int      @default(4)
  /// Urgency/deadline nudge this many hours after the proposal went out.
  urgencyAfterHours   Int      @default(24)
  /// Win-back offer after the lead has been cold for this many days.
  winBackAfterDays    Int      @default(7)
  /// Default proposal validity window.
  proposalExpiryHours Int      @default(48)
  /// After the win-back, a still-silent lead is explicitly marked lost.
  autoLoseAfterDays   Int      @default(14)
  updatedAt           DateTime @updatedAt
}

model RepairRequest {
  id            String    @id @default(cuid())
  hotelId       String
  roomId        String?
  title         String
  description   String?
  photos        String    @default("[]")
  priority      String    @default("medium")
  status        String    @default("open")
  source        String?   @default("reception")
  reportedById  String?
  assignedToId  String?
  slaMinutes    Int       @default(480)
  slaBreachedAt DateTime?
  resolvedAt    DateTime?
  resolvedNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  room          Room?     @relation(fields: [roomId], references: [id])

  @@index([hotelId, status, priority])
  @@index([roomId, createdAt])
}

model Wristband {
  id                   String    @id @default(cuid())
  hotelId              String
  reservationId        String
  guestId              String
  folioId              String
  code                 String    @unique
  status               String    @default("active")
  type                 String    @default("qr")
  spendingLimit        Float     @default(0)
  restrictedCategories String    @default("[]")
  note                 String?
  issuedAt             DateTime  @default(now())
  deactivatedAt        DateTime?
  createdAt            DateTime  @default(now())

  @@index([hotelId, status])
  @@index([code])
}

model WristbandScan {
  id          String   @id @default(cuid())
  hotelId     String
  wristbandId String
  outlet      String
  description String
  amount      Float
  category    String   @default("other")
  staffId     String?
  chargeId    String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  @@index([wristbandId])
  @@index([hotelId, createdAt])
}

model MiceEvent {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  companyId       String?
  status          String   @default("draft")
  canvas          String
  totalCost       Float    @default(0)
  deposit         Float    @default(0)
  depositPct      Float    @default(30)
  balanceDueDays  Int      @default(7)
  paymentSchedule String   @default("[]")
  proposalText    String?
  groupBlockId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, status])
}

model Proposal {
  id          String    @id @default(cuid())
  hotelId     String
  title       String
  number      String?
  companyId   String?
  companyName String?
  leadId      String?
  miceEventId String?
  type        String    @default("group")
  lang        String    @default("ru")
  template    String    @default("brand1")
  version     String    @default("v1")
  status      String    @default("draft") // draft | sent | accepted
  currency    String    @default("UZS")
  validUntil  DateTime?
  managerName String?
  bodyRu      String?
  bodyUz      String?
  bodyEn      String?
  conditions  String?
  totalCost   Float     @default(0)
  deposit     Float     @default(0)
  signStatus  String    @default("unsigned")
  signToken   String?
  sentVia     String?
  sentAt      DateTime?
  approvedAt  DateTime?
  esfNumber   String?
  actNumber   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hotelId, signStatus])
  @@index([miceEventId])
}

model SpaTherapist {
  id             String       @id @default(cuid())
  hotelId        String
  name           String
  /// JSON array of specialty keys; a treatment's requiredSpecialty must be in here.
  specialties    String       @default("[]")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  phone          String?
  /// Per-day working window, JSON: { "mon": ["09:00","18:00"], ... }.
  /// A day that is absent means the master does not work that day.
  shiftSchedule  String?
  /// Column tint on the schedule grid.
  color          String       @default("#6366F1")
  bookings       SpaBooking[] @relation("SpaBookingTherapist")
  /// Second master on a couple treatment — one booking, two people working it.
  coupleBookings SpaBooking[] @relation("SpaBookingSecondTherapist")

  @@index([hotelId])
}

model SpaRoom {
  id        String       @id @default(cuid())
  hotelId   String
  name      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  /// massage | sauna | pool | nail | facial | multi — must match the
  /// treatment's requiredRoomType (a 'multi' cabinet matches anything).
  type      String       @default("massage")
  /// 2+ means the cabinet can host a couple treatment.
  capacity  Int          @default(1)
  /// active | maintenance — a cabinet under maintenance takes no bookings.
  status    String       @default("active")
  bookings  SpaBooking[]

  @@index([hotelId])
}

model SpaTreatment {
  id                String       @id @default(cuid())
  hotelId           String
  name              String
  durationMin       Int          @default(60)
  price             Float        @default(0)
  category          String       @default("massage")
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  description       String?
  /// Price is VAT-inclusive; the receipt breaks the tax out as its own line.
  vatPercent        Float        @default(12)
  /// Uzbek tax classifier — required on the fiscal push.
  ikpuCode          String?
  /// Only masters carrying this specialty can be booked for it.
  requiredSpecialty String       @default("massage")
  requiredRoomType  String       @default("massage")
  /// Needs two masters and a cabinet with capacity >= 2, simultaneously.
  isCouple          Boolean      @default(false)
  /// Prep and cleanup. Both block the room AND the master, so the real
  /// occupied window is start-bufferBefore .. end+bufferAfter.
  bufferBeforeMin   Int          @default(0)
  bufferAfterMin    Int          @default(10)
  bookings          SpaBooking[]

  @@index([hotelId])
}

model SpaBooking {
  id                String        @id @default(cuid())
  hotelId           String
  reservationId     String?
  guestName         String
  guestPhone        String?
  therapistId       String?
  roomId            String?
  treatmentId       String?
  startTime         DateTime
  endTime           DateTime
  /// requested | confirmed | in_progress | completed | cancelled | no_show
  status            String        @default("confirmed")
  chargePosted      Boolean       @default(false)
  chargeId          String?
  reminderSent      Boolean       @default(false)
  upsellOffer       Boolean       @default(false)
  createdAt         DateTime      @default(now())
  /// in_house | external — decides whether completing posts to a folio or
  /// takes payment on the spot. The single most important field here.
  guestType         String        @default("in_house")
  guestId           String?
  folioId           String?
  /// Second master for a couple treatment.
  secondTherapistId String?
  /// Frozen at booking time: editing the catalog must never move the price of
  /// an appointment somebody has already agreed to.
  priceSnapshot     Float         @default(0)
  vatSnapshot       Float         @default(0)
  durationSnapshot  Int           @default(60)
  /// room_charge | rfid | cash | card — set at completion.
  paymentMethod     String?
  /// front_desk | online_widget | ai_concierge
  source            String        @default("front_desk")
  notes             String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  staffId           String?
  therapist         SpaTherapist? @relation("SpaBookingTherapist", fields: [therapistId], references: [id])
  secondTherapist   SpaTherapist? @relation("SpaBookingSecondTherapist", fields: [secondTherapistId], references: [id])
  room              SpaRoom?      @relation(fields: [roomId], references: [id])
  treatment         SpaTreatment? @relation(fields: [treatmentId], references: [id])

  @@index([hotelId, startTime])
  @@index([reservationId])
  @@index([hotelId, status])
  @@index([therapistId, startTime])
}

model RentalItem {
  id           String          @id @default(cuid())
  hotelId      String
  name         String
  type         String          @default("equipment")
  description  String?
  pricePerHour Float           @default(0)
  priceFlat    Float           @default(0)
  capacity     Int             @default(1)
  status       String          @default("available")
  tags         String          @default("[]")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  bookings     RentalBooking[]

  @@index([hotelId, type])
  @@index([hotelId, status])
}

model RentalBooking {
  id            String     @id @default(cuid())
  hotelId       String
  itemId        String
  reservationId String?
  guestName     String
  guestPhone    String?
  startTime     DateTime
  endTime       DateTime
  status        String     @default("booked")
  totalCost     Float      @default(0)
  chargePosted  Boolean    @default(false)
  chargeId      String?
  upsellType    String?
  createdAt     DateTime   @default(now())
  item          RentalItem @relation(fields: [itemId], references: [id])

  @@index([hotelId, startTime])
  @@index([itemId, startTime])
  @@index([reservationId])
}

model OutletConfig {
  id                String               @id @default(cuid())
  hotelId           String
  name              String
  type              String               @default("restaurant")
  fiscalized        Boolean              @default(false)
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  // Short code used on fiscal receipts and for segmenting revenue reports.
  outletCode        String               @default("")
  // Country-pack default; UZ is 12%. Menu items may override per line.
  defaultVatPercent Float                @default(12)
  // Fallback IKPU for menu items that have none — a fiscal push needs one.
  defaultIkpu       String?
  // Per-day open/close, JSON: { "mon": ["09:00","23:00"], ... }
  workingHours      String?
  serviceChargePct  Float                @default(0)
  orders            OutletOrder[]
  tables            FbTable[]
  menuItems         FbMenuItem[]
  tableReservations FbTableReservation[]

  @@index([hotelId])
}

/// Physical table in a restaurant/bar. Replaces OutletOrder.tableNumber's
/// free text, which could not carry status or capacity.
model FbTable {
  id             String       @id @default(cuid())
  hotelId        String
  outletId       String
  number         String
  zone           String?
  capacity       Int          @default(2)
  /// free | occupied | reserved | dirty | blocked
  status         String       @default("free")
  /// Set while a check is open on this table.
  currentOrderId String?
  /// When tables are combined, the followers point at the leader's id and the
  /// leader holds the single open order. Un-merging is manual: staff reassign
  /// items themselves rather than the system guessing which table ordered what.
  mergedInto     String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  outlet         OutletConfig @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([hotelId, outletId])
  @@index([outletId, status])
}

/// Menu catalog. Before this, every order line was retyped by hand, which is
/// why lines carried no VAT rate or IKPU and could not be fiscalized properly.
model FbMenuItem {
  id         String       @id @default(cuid())
  hotelId    String
  outletId   String
  name       String
  description String?
  imageUrl    String?
  category   String       @default("food")
  price      Float        @default(0)
  vatPercent Float        @default(12)
  /// Uzbek tax classifier code — required on the fiscal push.
  ikpuCode   String?
  halal      Boolean      @default(false)
  /// 86'd — still on the menu but unavailable right now.
  stopList   Boolean      @default(false)
  sortOrder  Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  outlet     OutletConfig @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([hotelId, outletId])
  @@index([outletId, category])
}

model FbTableReservation {
  id        String       @id @default(cuid())
  hotelId   String
  outletId  String
  guestId   String?
  /// For walk-in/non-resident bookings that have no Guest record.
  guestName String?
  phone     String?
  partySize Int          @default(2)
  /// Date at UTC midnight; `time` is "HH:mm" local to the property.
  date      DateTime
  time      String
  /// Assigned on arrival, not required at booking time.
  tableId   String?
  /// requested | confirmed | seated | no_show | cancelled
  status    String       @default("confirmed")
  /// front_desk | inbox | ai_concierge
  source    String       @default("front_desk")
  notes     String?
  createdAt DateTime     @default(now())
  outlet    OutletConfig @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([hotelId, date])
  @@index([outletId, date])
}

model OutletOrder {
  id               String            @id @default(cuid())
  hotelId          String
  outletId         String
  reservationId    String?
  folioId          String?
  tableNumber      String?
  roomId           String?
  /// open | preparing | served | payment_pending | closed | void
  status           String            @default("open")
  total            Float             @default(0)
  chargeId         String?
  fiscalizedAt     DateTime?
  staffId          String?
  note             String?
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  /// Structured replacement for tableNumber. Both are kept: tableNumber still
  /// holds the label so historical orders stay readable after a table is
  /// renamed or deleted.
  tableId          String?
  guestId          String?
  covers           Int               @default(1)
  /// total = subtotal + taxTotal + service. Split out so the receipt can show
  /// VAT as its own line rather than bundling it into the displayed price.
  subtotal         Float             @default(0)
  taxTotal         Float             @default(0)
  serviceTotal     Float             @default(0)
  /// cash | card | room_charge | rfid — null while the check is still open.
  paymentMethod    String?
  /// Room service only: where it goes ("№207", "Пляж, шезлонг 4").
  deliveryLocation String?
  /// Room service only: preparing | in_delivery | delivered
  deliveryStatus   String?
  openedBy         String?
  closedBy         String?
  voidedBy         String?
  voidReason       String?
  items            OutletOrderItem[]
  outlet           OutletConfig      @relation(fields: [outletId], references: [id])

  @@index([hotelId, status])
  @@index([reservationId])
  @@index([hotelId, createdAt])
  @@index([tableId])
}

model OutletOrderItem {
  id         String      @id @default(cuid())
  orderId    String
  /// name/price are deliberately snapshots taken at order time — a later menu
  /// price change must not retroactively alter an open or historical check.
  name       String
  qty        Int         @default(1)
  price      Float       @default(0)
  category   String      @default("food")
  /// Provenance only; the snapshot fields above are what gets charged.
  menuItemId String?
  vatPercent Float       @default(0)
  ikpuCode   String?
  /// ordered | served | void
  status     String      @default("ordered")
  /// Void audit is not optional — the Antifraud module consumes these.
  voidedBy   String?
  voidReason String?
  voidedAt   DateTime?
  order      OutletOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PredictionRisk {
  id             String    @id @default(cuid())
  hotelId        String
  type           String
  severity       String
  title          String
  detail         String
  source         String
  proposedAction String?
  actionTaken    String?
  autoResolved   Boolean   @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([hotelId, type, severity])
  @@index([hotelId, createdAt])
}

model PlatformReview {
  id            String    @id @default(cuid())
  hotelId       String
  platform      String
  platformId    String?
  guestName     String?
  guestId       String?
  rating        Int       @default(5)
  text          String?
  textRu        String?
  sentiment     String    @default("neutral")
  status        String    @default("new")
  aiReplyDraft  String?
  aiReplyStatus String    @default("draft")
  replyText     String?
  repliedAt     DateTime?
  ticketId      String?
  routeTo       String?
  /// Auto-tagged topic: spa | staff | cleanliness | food | maintenance | location | value | other
  category      String?
  /// Detected review language (ru | uz | en) — replies match it automatically.
  language      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hotelId, platform, status])
  @@index([guestId])
}

model Deal {
  id                  String         @id @default(cuid())
  hotelId             String
  title               String
  stage               String         @default("lead")
  status              String         @default("open")
  ownerId             String?
  companyId           String?
  miceEventId         String?
  groupBlockId        String?
  value               Float          @default(0)
  depositAmount       Float          @default(0)
  depositPaid         Boolean        @default(false)
  contractSigned      Boolean        @default(false)
  actSigned           Boolean        @default(false)
  currency            String         @default("UZS")
  probabilityOverride Float?
  expectedCloseDate   DateTime?
  lostReason          String?
  note                String?
  source              String? // where the deal came from (inbox, call, repeat)
  nextStep            String? // what this deal is waiting on
  nextStepAt          DateTime?
  checkIn             DateTime?
  checkOut            DateTime?
  roomsCount          Int            @default(0)
  // Release date for the held rooms. Mandatory once a block exists: unsold
  // rooms go back on sale on this date instead of sitting dead.
  cutoffAt            DateTime?
  cutoffRemindedAt    DateTime?
  cutoffReleasedAt    DateTime?
  // Set when the quote goes below the company's contract rate.
  requiresGmApproval  Boolean        @default(false)
  gmApprovedAt        DateTime?
  gmApprovedById      String?
  lastMovedAt         DateTime       @default(now())
  remindedAt          DateTime?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  activities          DealActivity[]
  blockRows           DealBlockRow[]
  payments            DealPayment[]

  @@index([hotelId, stage])
  @@index([hotelId, status])
  @@index([companyId])
  @@index([groupBlockId])
}

// One line of the room block being quoted: category x nights x quantity.
model DealBlockRow {
  id        String   @id @default(cuid())
  dealId    String
  category  String
  nights    Int      @default(1)
  qty       Int      @default(1)
  rate      Float    @default(0)
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// Staged payments (deposit, balance, …) with their own due dates.
model DealPayment {
  id        String    @id @default(cuid())
  dealId    String
  label     String
  amount    Float     @default(0)
  dueAt     DateTime?
  status    String    @default("pending") // pending | paid | overdue
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealActivity {
  id         String   @id @default(cuid())
  dealId     String
  type       String
  fromStage  String?
  toStage    String?
  message    String?
  amount     Float?
  documentId String?
  userId     String?
  createdAt  DateTime @default(now())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

/// In-app + delivery record for a single notification (P10.1). The "push"
/// channel is this row itself (read by the bell/Notifications screen); Telegram
/// and SMS are sent as side effects when those channels are configured.
model Notification {
  id          String    @id @default(cuid())
  hotelId     String
  trigger     String
  title       String
  body        String?
  roles       String    @default("[]") // recipient roles (JSON)
  channels    String    @default("[]") // channels delivered on (JSON)
  priority    String    @default("medium") // info | medium | high | critical
  status      String    @default("unread") // unread | read | escalated
  groupKey    String? // anti-spam dedup key (trigger:refId)
  refId       String?
  slaDeadline DateTime?
  escalatedAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([hotelId, status, createdAt])
  @@index([hotelId, groupKey])
}

/// Per-property override of a trigger's recipients/channels/priority/SLA.
model NotificationConfig {
  id         String  @id @default(cuid())
  hotelId    String
  trigger    String
  enabled    Boolean @default(true)
  roles      String  @default("[]")
  channels   String  @default("[]")
  priority   String  @default("medium")
  slaMinutes Int     @default(0)

  @@unique([hotelId, trigger])
}

model OfflineAction {
  id        String    @id @default(cuid())
  hotelId   String
  action    String
  payload   String
  status    String    @default("pending")
  retries   Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([hotelId, status, createdAt])
}

/// Reconnect sync journal (P9.2): one row per replayed action / deferred
/// external task, recording the outcome and when the catch-up happened.
model SyncLog {
  id        String   @id @default(cuid())
  hotelId   String
  action    String
  refId     String? // related reservation/document/etc.
  status    String // synced | resolved | conflict | failed | deferred
  detail    String?
  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
}

/// Above-limit action requiring GM/owner confirmation (P12.1). The intended
/// action + payload are stored so it can be executed verbatim on approval.
model ApprovalRequest {
  id              String    @id @default(cuid())
  hotelId         String
  action          String // refund | discount | comp | rate_override
  amount          Float     @default(0)
  reason          String?
  payload         String    @default("{}") // JSON: reservationId, method, note…
  status          String    @default("pending") // pending | approved | rejected
  requestedById   String?
  requestedByName String?
  requestedByRole String?
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  resultRef       String? // id of the payment/charge created on approval
  createdAt       DateTime  @default(now())

  @@index([hotelId, status, createdAt])
}

/// Backup & disaster-recovery journal (P12.1). One row per database per backup
/// run, recording the local + geo-replica copy, the verified restore test, and
/// any failure — so recoverability is provable and monitorable.
model BackupRun {
  id          String   @id @default(cuid())
  database    String // control | tenant:<orgId>
  kind        String   @default("scheduled") // scheduled | manual
  status      String   @default("ok") // ok | failed
  sizeBytes   Int      @default(0)
  primaryPath String? // local Uzbek (Tashkent) copy
  replicaPath String? // geographic replica copy
  restoreOk   Boolean  @default(false) // restore-test passed
  detail      String?
  createdAt   DateTime @default(now())

  @@index([database, createdAt])
}

/// Periodic restore verification (P-dbops). A backup that cannot be restored is
/// worthless, so this journals real restore-and-query checks separately from
/// the inline integrity check, per database.
model RestoreTest {
  id         String   @id @default(cuid())
  database   String // control | tenant:<orgId>
  backupId   String? // the BackupRun snapshot that was restored
  ok         Boolean  @default(false)
  rowsProbed Int      @default(0) // rows read from the restored copy as proof
  sizeBytes  Int      @default(0)
  detail     String?
  createdAt  DateTime @default(now())

  @@index([database, createdAt])
}

/// Schema-migration observability across the control DB and every tenant DB
/// (P0.6). One row per scope records which schema version it is on and whether
/// the last apply succeeded — so drift and failures are visible, not silent.
model SchemaMigration {
  id         String   @id @default(cuid())
  scope      String   @unique // control | <orgId>
  orgName    String?
  version    String // schema fingerprint last successfully applied
  target     String // the version we attempted to reach
  status     String   @default("applied") // applied | failed
  error      String?
  durationMs Int      @default(0)
  attempts   Int      @default(0)
  appliedAt  DateTime @default(now())
}

// ─── Front Office Workspace (shift-based operational workspace) ────────────
/// Lost & found register for housekeeping.
model LostItem {
  id           String   @id @default(cuid())
  hotelId      String
  description  String
  foundRoom    String? // room number where it was found
  foundBy      String? // staff name
  status       String   @default("stored") // stored | contact | returned
  guestInHouse Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([hotelId, status])
}

/// A front-office shift. Starting a shift generates a personalised task list
/// from the live workload; the workspace adapts as tasks are completed.
model Shift {
  id           String      @id @default(cuid())
  hotelId      String
  userId       String
  userName     String
  role         String      @default("front_desk")
  status       String      @default("active") // active | ended
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  handoverNote String?
  tasks        ShiftTask[]

  @@index([hotelId, status])
  @@index([userId, status])
}

/// One actionable item on a shift checklist, linked to the entity it concerns.
model ShiftTask {
  id        String   @id @default(cuid())
  shiftId   String
  kind      String // checkin | emehmon | reply | folio | request | custom
  label     String
  refId     String? // reservation/thread/folio id this resolves
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

/// Per-user widget layout for the workspace (which widgets, order, size).
/// roleDefault rows (userId = "role:<role>") provide shared starting layouts.
model WorkspaceLayout {
  id        String   @id @default(cuid())
  userId    String   @unique // a user id, or "role:<role>" for a shared default
  widgets   String   @default("[]") // JSON [{id, enabled, span}]
  updatedAt DateTime @updatedAt
}

// ─── Lego Access Builder (visual permission system, P13.x) ────────────────
/// A composable role. Built-in starter roles are seeded per organization
/// (isSystem); admins clone/compose custom roles from permission blocks.
model AccessRole {
  id             String            @id @default(cuid())
  organizationId String
  key            String // slug, unique per org
  name           String
  description    String?
  template       String? // origin template id
  baseRole       String? // maps to a legacy role (owner|gm|…) for fallback/labels
  color          String            @default("#64748b")
  icon           String?
  isSystem       Boolean           @default(false) // seeded starter; protected
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  grants         PermissionGrant[]
  parents        RoleInheritance[] @relation("childRole")
  children       RoleInheritance[] @relation("parentRole")

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// One allow/deny of a catalog permission (e.g. "payments.refund") on a role —
/// a permission "block" dropped on the canvas. Deny overrides allow.
model PermissionGrant {
  id         String         @id @default(cuid())
  roleId     String
  permission String // catalog key: "<module>.<action>"
  effect     String         @default("allow") // allow | deny
  createdAt  DateTime       @default(now())
  role       AccessRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  policies   AccessPolicy[]

  @@unique([roleId, permission])
  @@index([roleId])
}

/// A condition attached to a grant — the "sub-block" that narrows a permission
/// (amount limit, scope, field mask, time window).
model AccessPolicy {
  id        String          @id @default(cuid())
  grantId   String
  type      String // amount_limit|scope_assigned|scope_department|scope_property|field_mask|time_window
  config    String          @default("{}") // JSON
  createdAt DateTime        @default(now())
  grant     PermissionGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

/// Role-to-role inheritance edge (a role inherits all of its parents' grants).
model RoleInheritance {
  id        String     @id @default(cuid())
  roleId    String // child
  parentId  String // parent
  createdAt DateTime   @default(now())
  child     AccessRole @relation("childRole", fields: [roleId], references: [id], onDelete: Cascade)
  parent    AccessRole @relation("parentRole", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([roleId, parentId])
  @@index([roleId])
}

// ─── RFID Card Management ─────────────────────────────────────────────────

/// Physical RFID card issued to a guest for cashless spending.
model RfidCard {
  id                String            @id @default(cuid())
  hotelId           String
  uid               String            @unique // physical RFID chip UID
  type              String            @default("standard") // standard | child | day | staff
  status            String            @default("active") // active | blocked | expired | replaced
  guestId           String?
  folioId           String? // shared folio for this card group
  reservationId     String?
  cardRole          String            @default("primary") // primary | linked
  linkedCardIds     String            @default("[]") // JSON array of linked card IDs
  issuedBy          String?
  issuedAt          DateTime          @default(now())
  expiresAt         DateTime?
  replacedBy        String?
  blockReason       String? // why the card was blocked (audit / guest inquiries)
  dailyLimitUsd     Float?
  maxSingleTxUsd    Float?
  barAccess         Boolean           @default(true)
  allowedZones      String            @default("[]") // JSON array
  blockedZones      String            @default("[]") // JSON array
  dailySpentToday   Float             @default(0)
  lastResetDate     DateTime? // last midnight reset for daily counter
  offlineTrustLimit Float             @default(30)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  transactions      CardTransaction[]

  @@index([hotelId, status])
  @@index([uid])
  @@index([folioId])
  @@index([guestId])
}

/// One transaction on a card (authorized by /api/cards/authorize or synced offline).
model CardTransaction {
  id            String    @id @default(cuid())
  cardId        String
  hotelId       String
  folioId       String?
  type          String    @default("charge") // charge | auth | void | refund
  category      String    @default("other") // restaurant|spa|rental|minibar|room_service|other
  amountUsd     Float     @default(0)
  amountUzs     Float     @default(0)
  description   String?
  terminalId    String?
  operatorId    String?
  operatorName  String?
  status        String    @default("approved") // approved | declined | voided
  declineReason String?
  offline       Boolean   @default(false)
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  card          RfidCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([hotelId, createdAt])
  @@index([terminalId, createdAt])
}

/// One step of an approval chain: above `threshold` for `trigger`, the action
/// needs `approverRole` confirmation. Ordered by chainOrder.
model ApprovalRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trigger        String // discount | refund | rate_change | void | comp
  comparator     String   @default("gt") // gt | gte
  threshold      Float    @default(0)
  approverRole   String // role key that must approve
  chainOrder     Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId, trigger, chainOrder])
}

/// A physical place on the resort territory: the restaurant, the banya, the
/// gazebo by the lake, the ATM. The guest app's Property Guide is built from
/// these.
///
/// Why this model exists when the guide is supposed to own no catalog: it
/// doesn't. Products (treatments, dishes, rental gear) stay in SpaTreatment /
/// FbMenuItem / RentalItem and are pulled in by the link fields below. What is
/// genuinely new here is the *place* — its photos, its pin on the territory
/// map, its opening hours. Nothing in the PMS modelled that before, because
/// staff-facing screens never needed to answer "where is the banya".
model GuidePlace {
  id            String   @id @default(cuid())
  hotelId       String
  /// eat | spa | activity | space | practical — drives the guide's sections.
  category      String   @default("space")
  /// Operational language (Russian), matching every other catalog in the PMS.
  name          String
  nameUz        String?
  nameEn        String?
  description   String?
  descriptionUz String?
  descriptionEn String?
  /// JSON array of image URLs, served from the backend's public assets.
  photos        String   @default("[]")
  /// JSON { "mon": ["09:00","23:00"], ... }, same shape as OutletConfig.
  /// Null means "no fixed hours" (a gazebo), not "closed".
  hours         String?
  /// Pin position on the territory map image, normalised 0..1 from the top
  /// left. Normalised rather than lat/lng because the map is an illustration
  /// of one property, not a slice of the world.
  mapX          Float?
  mapY          Float?
  /// Shown on the place card so a guest can call the outlet directly.
  phone         String?
  /// Free text: "2nd floor", "by the lower pool".
  locationHint  String?
  /// Link into the real catalogs. Set at most one — it decides which product
  /// list the place shows.
  outletId      String?
  spaCategory   String?
  rentalType    String?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([hotelId, category, sortOrder])
}

/// Replay protection for guest-app writes.
///
/// The app queues actions while offline and sends them when the connection
/// returns, so the same booking or room-service order can legitimately be sent
/// more than once — a lost response is indistinguishable from a lost request.
/// Each queued action carries a client-generated key; the first attempt stores
/// its result here and every retry replays that stored result instead of
/// creating a second order or a second charge.
model GuestIdempotency {
  id            String   @id @default(cuid())
  hotelId       String
  /// Client-generated, unique per queued action.
  key           String   @unique
  /// Which stay sent it — a key from one stay must never replay another's.
  reservationId String
  /// spa_booking | room_service | request | complaint
  kind          String
  /// The response the first attempt returned, replayed verbatim on retry.
  result        String
  createdAt     DateTime @default(now())

  @@index([hotelId, reservationId])
}

/// ─── Guest identity (control database) ────────────────────────────────────
///
/// A person, not a stay. Lives in the control DB rather than a tenant DB
/// because one traveller may stay at several Atlas properties, and an identity
/// scoped to a single hotel's database could never see the other stays.
///
/// The tenant `Guest` row stays exactly where it is — it is the hotel's
/// operational record (passport, PINFL, consent, preferences) and remains the
/// source of truth. This is only the login identity, joined to those rows by
/// GuestAccountLink.
model GuestAccount {
  id             String    @id @default(cuid())
  /// The person. Normalised so "+998 90 766 96 65" and "998907669665" are the
  /// same human. Not what they type to sign in — that is `login`.
  phone          String    @unique
  /// What the guest types. Reception sets it when creating the account and can
  /// change it later; it defaults to the phone number, the one string a guest
  /// reliably knows.
  ///
  /// Uniqueness is enforced in code (createAccountForGuest / changeLogin), NOT
  /// by a database constraint, and that is deliberate. Provisioning applies
  /// the schema additively on every boot — `ALTER TABLE ADD COLUMN` plus a
  /// separate CREATE UNIQUE INDEX — and SQLite cannot add a unique column to a
  /// populated table. Declaring @unique here left the control database with an
  /// index that did not match its rows ("database disk image is malformed"),
  /// which would have happened to every tenant database on the next deploy.
  /// Do not add @unique to a column introduced after a table already exists.
  login          String?
  /// bcrypt, set by the GUEST on first entry — never by staff. Null means
  /// "not activated yet", which is how that state is represented rather than
  /// with a separate flag that could drift out of sync.
  passwordHash   String?
  /// Brute-force guard. A login is often a phone number, so the search space
  /// is small enough that unlimited attempts would be a real risk.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  email          String?
  fullName       String?
  /// ru | uz | en — so notifications can be written in the guest's language.
  locale         String    @default("ru")
  lastLoginAt    DateTime?
  /// Set if the account is blocked; every session check honours it.
  blockedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  links GuestAccountLink[]
  otps  GuestOtp[]
}

/// Joins a login identity to the hotel's own guest record, one row per
/// property. This is what makes "my stays" a server-side lookup instead of
/// something the client asks for by id.
model GuestAccountLink {
  id         String   @id @default(cuid())
  accountId  String
  propertyId String
  /// Guest.id inside that property's tenant database.
  guestId    String
  createdAt  DateTime @default(now())

  account GuestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, propertyId, guestId])
  @@index([propertyId, guestId])
}

/// A one-time login code.
///
/// Only the hash is stored: an OTP is a bearer credential for the whole
/// account, so a leaked database should not hand over live codes. `attempts`
/// caps guessing — six digits is a million combinations, which is a lot for a
/// person and nothing for a script.
model GuestOtp {
  id         String    @id @default(cuid())
  accountId  String?
  /// Kept alongside the account so a code can be issued before the account
  /// row is certain, and so lookups never need the account id.
  phone      String
  codeHash   String
  /// telegram | reception | log — how the guest actually received it. Shown
  /// to the guest so they know where to look.
  channel    String    @default("reception")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  account GuestAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
}
